# s390x-safe version of api/Containerfile. python:3.11-slim fails on s390x: numpy has no wheel and the image has no compiler. apt supplies s390x builds of numpy/scipy/xgboost; python3-sklearn is required because ml/scoring.py loads XGBClassifier.
# Build from repo root on LinuxONE:  podman build -t timetotalk-api -f api/Containerfile.ubuntu .
# Run with --network host so the API can reach Granite (llama-server on 127.0.0.1:8080). See docs/SETUP.md.
FROM ubuntu:24.04
RUN useradd --create-home appuser
WORKDIR /app
COPY api/requirements.txt .
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip python3-numpy python3-scipy python3-xgboost python3-sklearn python-is-python3 && rm -rf /var/lib/apt/lists/* && pip install --no-cache-dir --break-system-packages -r requirements.txt
COPY ml/coxph.py ml/logit.py ml/scoring.py ml/explain.py /app/ml/
COPY genai /app/genai
COPY api/app.py /app/
COPY artifacts /app/artifacts
ENV TTT_ARTIFACTS=/app/artifacts TTT_AUDIT_LOG=/app/logs/audit.log
RUN mkdir -p /app/logs && chown -R appuser /app/logs
# run as non-root (security screenshot)
USER appuser
EXPOSE 8000
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]
